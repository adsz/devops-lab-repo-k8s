global_defs {
    router_id LB_{{ ansible_hostname }}
    script_user root
    enable_script_security
}

vrrp_script chk_haproxy {
    script "/bin/kill -0 `cat /var/run/haproxy.pid`"
    interval 2
    weight 2
    fall 3
    rise 2
}

vrrp_instance VI_1 {
    state {% if inventory_hostname == groups['k8s_loadbalancers'][0] %}MASTER{% else %}BACKUP{% endif %}
    
    interface {{ ansible_default_ipv4.interface }}
    virtual_router_id 51
    priority {% if inventory_hostname == groups['k8s_loadbalancers'][0] %}150{% else %}100{% endif %}
    
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass k8s_ha_pass
    }
    # DEPRECATED: This template is for old dedicated k8s-lb VM (192.168.0.175)
    # VM decommissioned 2025-11-12 - replaced by centralized HAProxy HA cluster
    # Current VIP: 192.168.0.150 (managed on ol01 MASTER, pi03 BACKUP via /repos/devops-lab-new/svc-load-balancer/)
    # DNS: k8s-api.devops-lab.cloud → 192.168.0.150
    # Note: This file kept for reference only - no longer deployed
    virtual_ipaddress {
        # 192.168.0.200/24  # OLD VIP never used - incorrect configuration
        # 192.168.0.175/24  # OLD dedicated k8s-lb VM IP - VM decommissioned
    }
    track_script {
        chk_haproxy
    }
}